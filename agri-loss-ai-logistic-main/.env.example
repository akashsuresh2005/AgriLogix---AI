# Agri Loss AI Logistic - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.

# ── API Keys ──────────────────────────────────────────────────────────────────
WEATHER_API_KEY=your_openweather_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
MARKET_API_KEY=your_market_data_api_key_here

# ── Database & Authentication ────────────────────────────────────────────────
# Local development default: sqlite:///./postharvest.db
# Production PostgreSQL example: postgresql://username:password@localhost:5432/agri_loss_db
DATABASE_URL=sqlite:///./postharvest.db

# Strong secret key for JWT signing (generate using: openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_secret_key_for_production

# ── SMTP / Email Notification Configuration (Optional) ───────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
